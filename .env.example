# Required: PostgreSQL connection string
# Supports any PostgreSQL provider (Neon, AWS RDS, Supabase, local, etc.)
# Get yours from your provider's dashboard
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# For local development with Docker:
# docker run --name flm-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_league_manager
